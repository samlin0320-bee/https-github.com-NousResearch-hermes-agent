# ============================================================
# AI 公司 Docker 部署機密設定範本
# 用法：複製成 .env（同目錄），填入實際值後執行 docker compose
#   cp .env.company.example .env
# .env 已被 .gitignore 忽略，不會進 git。
# ============================================================

# Google AI Studio 金鑰（主要模型 gemini-2.0-flash）
GOOGLE_AI_STUDIO_API_KEY=REPLACE_ME

# 允許使用的 Telegram 使用者 ID（你的個人 ID）
TELEGRAM_ALLOWED_USERS=REPLACE_ME

# Telegram 頻道 ID
TELEGRAM_WATER_COOLER_ID=REPLACE_ME
TELEGRAM_DEV_LOG_ID=REPLACE_ME
TELEGRAM_APPROVAL_ID=REPLACE_ME
TELEGRAM_CONTENT_ID=REPLACE_ME

# 6 個 Agent bot token（從 @BotFather 建立）
LALA_BOT_TOKEN=REPLACE_ME
LUMI_BOT_TOKEN=REPLACE_ME
ORI_BOT_TOKEN=REPLACE_ME
CRAFT_BOT_TOKEN=REPLACE_ME
SAGE_BOT_TOKEN=REPLACE_ME
PIXEL_BOT_TOKEN=REPLACE_ME
